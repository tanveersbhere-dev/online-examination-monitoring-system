# Environment variables template

# Application settings
PROJECT_NAME="Online Examination Monitoring System API"
API_V1_STR="/api/v1"
DEBUG=True

# Security settings
# Provide a comma-separated list of origins for CORS
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database connection
# Format: postgresql+asyncpg://user:password@server:port/db
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/exam_db"

# AI Engine configuration (mock values for now)
AI_ENGINE_ENABLED=True
AI_ENGINE_URL="http://localhost:8001"
# SMTP Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@gmail.com"
SMTP_PASSWORD="your-16-character-app-password"
SMTP_FROM="your-email@gmail.com"