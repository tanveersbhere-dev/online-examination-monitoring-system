# ==============================================================================
# ExamShield - Online Examination Monitoring System
# Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env in your respective service directories or deployment root.
# NEVER commit production secrets or real passwords to source control.
# ==============================================================================

# --- Core Backend API Configuration ---
PROJECT_NAME="Online Examination Monitoring System API"
API_V1_STR="/api/v1"
DEBUG=False
PORT=8000
HOST="127.0.0.1"

# --- Security & JWT Authentication ---
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-with-a-secure-random-32-character-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database Connection (PostgreSQL) ---
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/exam_db"

# --- Cross-Origin Resource Sharing (CORS) ---
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# --- SMTP Email Notifications (Examiner & Student Notifications) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-institution-email@gmail.com"
SMTP_PASSWORD="your-secure-app-password"
SMTP_FROM="ExamShield Notifications <your-institution-email@gmail.com>"
SMTP_FROM_EMAIL="your-institution-email@gmail.com"

# --- AI Monitoring Engine Integration ---
AI_ENGINE_ENABLED=True
AI_ENGINE_URL="http://127.0.0.1:8001"
AI_WS_URL="ws://127.0.0.1:8001/ws/monitor"

# --- Frontend Client Configuration ---
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"
VITE_WS_BASE_URL="ws://127.0.0.1:8000/ws"
