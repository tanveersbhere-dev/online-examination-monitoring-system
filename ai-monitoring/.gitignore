# ==============================================================================
# Project-Specific .gitignore for AI Monitoring V1
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Virtual Environments & Package Managers
# ------------------------------------------------------------------------------
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 2. Python Caches & Compiled Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 3. Test & Coverage Artifacts
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
nosetests.xml
coverage.xml
*.cover
*.pyt

# ------------------------------------------------------------------------------
# 4. Frontend Dependencies & Build Outputs
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. Generated Runtime Evidence, Logs & Temporary Files
# ------------------------------------------------------------------------------
# Ignore generated runtime snapshot evidence images
backend/evidence/*.jpg
backend/evidence/*.png
evidence/playground/*.jpg
evidence/playground/*.png

# Scratch space & temp reports
scratch/
scratch_report.txt

# Runtime logs
*.log
logs/

# ------------------------------------------------------------------------------
# 6. Local Configuration, Secrets & Environment Variables
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json
secrets/

# Local databases
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# 7. IDE, Editor & OS Specific Files
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini


# Training runs / generated artifacts
runs/

# Generated evidence
evidence/playground/
evidence/wearable_audio/

# Local/runtime evidence
backend/evidence/

# Diagnostic temporary captures
tools/wearable_audio/diagnostic_output/